{
  "name": "dna-encoder",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side DNA encoder/decoder: a deterministic bit-to-nucleotide cipher (Rust/WASM) in a static Next.js app.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/inject-csp.mjs",
    "serve:out": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "wasm": "node scripts/build-wasm.mjs",
    "test:rust": "cargo test --manifest-path dna-cipher/Cargo.toml",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:rust"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
